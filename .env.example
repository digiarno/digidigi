# Public site origin used for canonical URLs, sitemap, Open Graph and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://lukkan.fi

# CookieYes GDPR banner — loaded first in <head> before any tracking.
NEXT_PUBLIC_COOKIEYES_ID=

# Google Tag Manager container (GTM-XXXX). Loaded afterInteractive after consent tooling.
NEXT_PUBLIC_GTM_ID=

# Google Analytics 4 measurement ID (G-XXXX). Optional if GTM already ships GA4.
NEXT_PUBLIC_GA4_ID=

# Meta / Facebook Pixel ID.
NEXT_PUBLIC_META_PIXEL_ID=

# External chat widget script URL (HubSpot, Zendesk, etc.). Lazy-loaded client-side.
NEXT_PUBLIC_CHAT_WIDGET_URL=

# Sales inbox that receives tarjouspyyntö emails. Never hardcode this in source.
NEXT_PUBLIC_CONTACT_RECEIVER=myynti@example.com

# Resend API key for /api/contact. Leave empty to run in stub/demo mode.
RESEND_API_KEY=

# Optional From address for Resend (must be a verified domain).
RESEND_FROM_EMAIL=Lukkan <noreply@example.com>

# Replicate token for /api/visualize (Stable Diffusion / Flux inpainting).
# Leave empty to serve a mocked before/after demo.
REPLICATE_API_TOKEN=

# Optional Replicate model version. Defaults to a Flux/SD inpainting placeholder id.
REPLICATE_MODEL_VERSION=

# Google Maps JavaScript API key for /jalleenmyyjat. Client-side, so NEXT_PUBLIC_.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional hero background video (mp4). Leave empty to use the static poster only.
NEXT_PUBLIC_HERO_VIDEO_URL=
